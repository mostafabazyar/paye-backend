generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  name          String?
  age           Int?
  gender        String?
  bio           String?
  photos        String?  // JSON stringified array
  avgRating     Float    @default(0)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profiles      Profile[]
  sentRequests  Request[] @relation("SentRequests")
  receivedRequests Request[] @relation("ReceivedRequests")
}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          String
  exerciseType    ExerciseType
  genderPreference GenderPreference
  title           String
  location        String
  maxInvites      Int      @default(1)
  goDutch         Boolean  @default(false)
  moreInfo        String?
  tags            String   // Comma-separated tags
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests        Request[]
  
  @@index([userId])
}

model Request {
  id           Int      @id @default(autoincrement())
  profileId    Int
  requesterId  String
  receiverId   String
  status       RequestStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requester    User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@unique([profileId, requesterId])
  @@index([profileId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
}

enum ExerciseType {
  ONE_ON_ONE
  MANY_ON_MANY
  ONE_ON_MANY
}

enum GenderPreference {
  MEN_ONLY
  WOMEN_ONLY
  ANY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}