generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  name          String?
  birthDate     DateTime?
  gender        String?
  interestedIn  InterestedIn @default(EVERYONE)

  // session types stay as a comma-joined string for now
  preferredSessionTypes String?

  bio           String?
  photos        String?
  avgRating     Float    @default(0)
  isVerified    Boolean  @default(false)
  isBlocked     Boolean  @default(false)

  // location (added)
  countryId      Int?
  cityId         Int?
  neighborhoodId Int?
  latitude       Float?
  longitude      Float?

  country        Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city           City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  sports         UserSport[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages         Message[]
  profiles         Profile[]
  sentRequests     Request[] @relation("SentRequests")
  receivedRequests Request[] @relation("ReceivedRequests")
  admin            Admin?

  @@index([countryId])
  @@index([cityId])
  @@index([neighborhoodId])
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]
  
  @@index([userId])

  isSuperAdmin Boolean @default(false)

}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          String
  exerciseType    ExerciseType
  genderPreference GenderPreference
  title           String
  location        String
  scheduledAt     DateTime?
  maxInvites      Int      @default(1)
  goDutch         Boolean  @default(false)
  moreInfo        String?
  tags            String   // Comma-separated tags
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests        Request[]
  
  @@index([userId])
}

model Request {
  id           Int      @id @default(autoincrement())
  profileId    Int
  requesterId  String
  receiverId   String
  status       RequestStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requester    User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@unique([profileId, requesterId])
  @@index([profileId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  senderId  String
  sessionId String
  sender    User     @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  
  @@index([phone])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([createdAt])
}

model Sport {
  id         String   @id @default(uuid())
  name       String   @unique
  slug       String   @unique
  icon       String?
  sortOrder  Int      @default(0)
  category   String?
  isActive   Boolean  @default(true)
  createdBy  String?
  createdAt  DateTime @default(now())

  users      UserSport[]

  @@index([isActive])
  @@index([sortOrder])
}

model UserSport {
  userId  String
  sportId String

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Restrict)

  @@id([userId, sportId])
  @@index([sportId])
}

model Country {
  id        Int      @id @default(autoincrement())
  code      String   @unique        // "IR", "US"
  name      String   @unique        // "Iran"
  nameFa    String?                 // "ایران"
  createdAt DateTime @default(now())

  cities    City[]
  users     User[]
}

model City {
  id            Int            @id @default(autoincrement())
  countryId     Int
  name          String         // "Tehran"
  nameFa        String?        // "تهران"
  createdAt     DateTime       @default(now())

  country       Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  neighborhoods Neighborhood[]
  users         User[]

  @@unique([countryId, name])
  @@index([countryId])
}

model Neighborhood {
  id        Int      @id @default(autoincrement())
  cityId    Int
  name      String
  nameFa    String?
  createdAt DateTime @default(now())

  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([cityId, name])
  @@index([cityId])
}

model DraftUser {
  id             String   @id @default(uuid())
  userId         String?  @unique
  phone          String
  name           String?
  birthDate      DateTime?
  gender         String?
  interestedIn   InterestedIn?

  countryId      Int?
  cityId         Int?
  neighborhoodId Int?
  latitude       Float?
  longitude      Float?

  sportsSlugs    String?  // JSON array of slugs captured during the wizard
  sessionTypes   String?
  bio            String?

  lastStep       Int      @default(1)
  completedAt    DateTime?
  abandonedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phone])
  @@index([completedAt])
  @@index([abandonedAt])
}

enum ExerciseType {
  ONE_ON_ONE
  MANY_ON_MANY
  ONE_ON_MANY
}

enum GenderPreference {
  MEN_ONLY
  WOMEN_ONLY
  ANY
}

enum InterestedIn {
  MEN
  WOMEN
  EVERYONE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
